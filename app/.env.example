# Copy to app/.env and paste your own key. app/.env is gitignored.
#
# Free tier: 20 requests/minute, 50/day. Get a key at openrouter.ai.
# You must be 13+ and, if under 18, have a parent or guardian's permission.
#
# NOTE: EXPO_PUBLIC_* values are inlined into the JS bundle and are extractable
# from a shipped build. Fine for a demo key with no credit on it. For a public
# release, put a proxy in front and keep the key on the server.
EXPO_PUBLIC_OPENROUTER_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
